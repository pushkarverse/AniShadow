{
  "name": "ani-shadow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api,side -c cyan,magenta,yellow \"vite\" \"tsx watch server/index.ts\" \"node scripts/run-sidecar.mjs --keep-alive\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "sidecar": "node scripts/run-sidecar.mjs",
    "build": "vite build && pnpm build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --alias:@=./src --outfile=dist-server/index.mjs --log-level=warning",
    "start": "node dist-server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "smoke-test": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@consumet/extensions": "^1.8.8",
    "@hono/node-server": "^1.14.1",
    "cheerio": "^1.2.0",
    "framer-motion": "^12.38.0",
    "hls.js": "^1.6.15",
    "hono": "^4.7.7",
    "lucide-react": "^0.577.0",
    "nprogress": "^0.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^20",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.4",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "typescript": "^5",
    "typescript-eslint": "^8.33.0",
    "vite": "^7.0.0"
  }
}
